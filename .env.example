# ---- 数据 ----
# SQLite 数据目录（Railway 上挂 Volume 后指到挂载点，如 /data）
DATA_DIR=./data

# ---- AI 驻场策划（不配置也能用平台，AI 面板会提示未配置）----
# 三类供应商任选（base_url 含 "anthropic" 时自动走 Claude 原生协议）：
#   OpenAI:    AI_BASE_URL=https://api.openai.com/v1         AI_MODEL=gpt-5-mini（快，推荐）或 gpt-5.1
#   Claude:    AI_BASE_URL=https://api.anthropic.com         AI_MODEL=claude-haiku-4-5（快而便宜）或 claude-sonnet-5
#   DeepSeek:  AI_BASE_URL=https://api.deepseek.com          AI_MODEL=deepseek-chat
#   Qwen:      AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# gpt-5 系推理深度（minimal/low/medium/high），交互式工作台建议 low
AI_REASONING_EFFORT=low

# 每把编辑钥匙的每日 AI 配额（防薅）
AI_DAILY_REQUESTS=40
AI_DAILY_TOKENS=400000

# 首页「旗舰作品」外链位（不设则不显示），如 val manager 的公网地址
FLAGSHIP_URL=

