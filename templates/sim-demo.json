{
  "schemaVersion": 1,
  "meta": {
    "title": "电竞经理 Lite",
    "description": "接手一支中游战队，三个赛季，看你能带它走多远。每周安排训练、转会、团建，然后打比赛——经营模拟调度器的官方示范。",
    "author": "官方示例",
    "intro": "你接手了中游战队「北辰」。预算有限，赛程无情。\n一个赛季 10 周，每周你可以安排训练、转会、商务，然后迎来一场联赛。\n三个赛季之后，人们会怎么记住你？"
  },
  "theme": {
    "preset": "dark",
    "accent": "#4a90d9"
  },
  "driver": {
    "kind": "sim",
    "time": {
      "turnLabel": "周",
      "cycleLabel": "赛季",
      "turnsPerCycle": 10,
      "maxCycles": 3
    },
    "drawsPerTurn": 1
  },
  "vars": [
    {
      "id": "资金",
      "name": "资金",
      "initial": 60,
      "min": 0,
      "max": 999
    },
    {
      "id": "声望",
      "name": "声望",
      "initial": 35,
      "min": 0,
      "max": 100
    },
    {
      "id": "士气",
      "name": "士气",
      "initial": 60,
      "min": 0,
      "max": 100
    },
    {
      "id": "积分",
      "name": "积分",
      "initial": 0,
      "min": 0,
      "max": 99,
      "resetEachCycle": true
    },
    {
      "id": "冠军数",
      "name": "冠军",
      "initial": 0,
      "min": 0,
      "max": 9
    },
    {
      "id": "运势",
      "name": "运势",
      "initial": 0,
      "min": 0,
      "max": 1,
      "visible": false
    }
  ],
  "entityTypes": [
    {
      "id": "选手",
      "name": "选手",
      "attributes": [
