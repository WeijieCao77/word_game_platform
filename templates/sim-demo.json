  "actions": [
    {
      "id": "特训枪法",
      "name": "特训·枪法",
      "description": "花 3 万加练枪法（受潜力上限约束，消耗体能）",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\") && !tag(\"伤病\")"
      },
      "condition": "资金 >= 3",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-3"
        },
        {
          "ref": "target.枪法",
          "op": "add",
          "value": "target.枪法 < target.潜力 ? randint(1, 3) : (chance(0.3) ? 1 : 0)"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "-randint(2, 5)"
        }
      ],
      "text": "加练枪法：{target.name} 枪法 → {target.枪法}"
    },
    {
      "id": "特训意识",
      "name": "特训·意识",
      "description": "花 3 万复盘录像磨意识（受潜力上限约束）",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\") && !tag(\"伤病\")"
      },
      "condition": "资金 >= 3",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-3"
        },
        {
          "ref": "target.意识",
          "op": "add",
          "value": "target.意识 < target.潜力 ? randint(1, 3) : (chance(0.3) ? 1 : 0)"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "-randint(1, 4)"
        }
      ],
      "text": "复盘特训：{target.name} 意识 → {target.意识}"
    },
    {
      "id": "体能调理",
      "name": "体能调理",
      "description": "花 2 万请理疗师，恢复体能",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\")"
      },
      "condition": "资金 >= 2",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-2"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "randint(6, 12)"
        }
      ],
      "text": "理疗调理：{target.name} 体能 → {target.体能}"
    },
    {
      "id": "签下新援",
      "name": "转会·签人",
      "description": "按身价从转会市场签人（名字旁不显示身价？看日志报价）",
      "target": {
        "entityType": "选手",
        "condition": "tag(\"市场\") && self.身价 <= 资金"
      },
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-target.身价"
        },
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "市场"
        },
        {
          "ref": "target",
          "op": "add_tag",
          "tag": "主力"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "3"
