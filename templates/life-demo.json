{
  "schemaVersion": 1,
  "meta": {
    "title": "修仙人生重开",
    "description": "投个好胎不如生个好灵根。一次随机的修仙人生：测灵根、入仙门、渡心魔，或者做个富家翁也不错。",
    "author": "官方示例",
    "intro": "混沌初分，一点灵光落入凡尘——是你。\n上天掷下这一世的底子，但轮回镜前，你还有 8 点天赋可以亲手分配：\n投在灵根、悟性、体魄、家境还是气运，决定你的出身，也决定往后的机遇与劫数。"
  },
  "theme": { "preset": "paper", "accent": "#8a6d3b" },
  "driver": {
    "kind": "life",
    "time": { "label": "岁", "start": 0, "step": 1, "max": 100 }
  },
  "vars": [
    { "id": "灵根", "name": "灵根", "initial": 1, "min": 1, "max": 12 },
    { "id": "悟性", "name": "悟性", "initial": 1, "min": 1, "max": 12 },
    { "id": "体魄", "name": "体魄", "initial": 50, "min": 0, "max": 100 },
    { "id": "家境", "name": "家境", "initial": 5, "min": 0, "max": 99 },
    { "id": "道心", "name": "道心", "initial": 50, "min": 0, "max": 100 },
    { "id": "修为", "name": "修为", "initial": 0, "min": 0, "max": 9999 },
    { "id": "气运", "name": "气运", "initial": 0, "min": 0, "max": 10 },
    { "id": "天赋点", "name": "天赋点", "initial": 8, "min": 0, "max": 20, "visible": false },
    { "id": "仙途", "name": "仙途", "initial": 0, "min": 0, "max": 2, "visible": false },
    { "id": "运势", "name": "运势", "initial": 0, "min": 0, "max": 1, "visible": false },
    { "id": "道侣", "name": "道侣", "initial": 0, "min": 0, "max": 1, "visible": false },
    { "id": "仇怨", "name": "仇怨", "initial": 0, "min": 0, "max": 5, "visible": false },
    { "id": "魔染", "name": "魔染", "initial": 0, "min": 0, "max": 9, "visible": false },
    { "id": "残魂", "name": "残魂", "initial": 0, "min": 0, "max": 1, "visible": false }
  ],
  "cards": [
    {
      "id": "投胎",
      "title": "开局：轮回掷点",
      "priority": 100,
      "once": true,
      "condition": "time == 1",
      "text": "轮回镜亮起，上天先掷下这一世的底子——灵根 {灵根}，悟性 {悟性}，体魄 {体魄}，家境 {家境}。\n镜旁还悬着 {天赋点} 点天赋，等你亲手落子。",
      "effects": [
        { "ref": "灵根", "op": "set", "value": "randint(1, 4)" },
        { "ref": "悟性", "op": "set", "value": "randint(1, 4)" },
        { "ref": "体魄", "op": "set", "value": "randint(35, 50)" },
        { "ref": "家境", "op": "set", "value": "randint(1, 4)" }
      ],
      "goto": "天赋分配"
    },
    {
      "id": "天赋分配",
      "title": "开局：天赋加点（goto 自环）",
      "text": "剩余天赋 {天赋点} 点。当前底子：灵根 {灵根} · 悟性 {悟性} · 体魄 {体魄} · 家境 {家境} · 气运 {气运}",
      "choices": [
        {
          "id": "加灵根",
          "label": "灵根 +1（仙缘之本，决定能否踏上修行路）",
          "condition": "天赋点 >= 1",
          "effects": [
            { "ref": "灵根", "op": "add", "value": "1" },
            { "ref": "天赋点", "op": "add", "value": "-1" }
          ],
          "goto": "天赋分配"
        },
        {
          "id": "加悟性",
          "label": "悟性 +1（读书修行皆事半功倍）",
          "condition": "天赋点 >= 1",
          "effects": [
            { "ref": "悟性", "op": "add", "value": "1" },
            { "ref": "天赋点", "op": "add", "value": "-1" }
          ],
          "goto": "天赋分配"
        },
        {
          "id": "加体魄",
          "label": "体魄 +5（底子硬，扛得住病痛与凶险）",
          "condition": "天赋点 >= 1",
          "effects": [
            { "ref": "体魄", "op": "add", "value": "5" },
            { "ref": "天赋点", "op": "add", "value": "-1" }
          ],
          "goto": "天赋分配"
        },
        {
          "id": "加家境",
          "label": "家境 +2（投个好胎，起点即高台）",
          "condition": "天赋点 >= 1",
          "effects": [
            { "ref": "家境", "op": "add", "value": "2" },
            { "ref": "天赋点", "op": "add", "value": "-1" }
          ],
          "goto": "天赋分配"
        },
        {
          "id": "加气运",
          "label": "气运 +1（机缘、捡漏与渡劫都看它）",
          "condition": "天赋点 >= 1",
          "effects": [
            { "ref": "气运", "op": "add", "value": "1" },
            { "ref": "天赋点", "op": "add", "value": "-1" }
          ],
          "goto": "天赋分配"
        },
        {
          "id": "落地投胎",
          "label": "落地投胎，这一世就这么定了",
          "condition": "天赋点 == 0",
          "text": "尘缘定，胎衣落。啼哭声里，这一世开始了。"
        }
      ]
    },
    {
      "id": "开蒙",
      "title": "主线：六岁开蒙",
      "priority": 90,
      "once": true,
      "condition": "time == 6",
      "text": "六岁开蒙。先生摸着你的头说：「此子{悟性 >= 6 ? \"目有精光，非池中之物\" : \"资质平平，贵在踏实\"}。」",
      "effects": [{ "ref": "悟性", "op": "add", "value": "1" }]
    },
    {
      "id": "测灵根上品",
      "title": "主线：八岁测灵根（上品）",
      "priority": 80,
      "once": true,
      "condition": "time == 8 && 灵根 >= 7",
      "text": "八岁这年，云游的仙门长老路过村口，灵石在你掌心亮得像一轮小太阳——上品灵根！",
      "choices": [
        {
          "id": "拜入仙门",
          "label": "拜入仙门，从此长生路上争渡",
          "effects": [
            { "ref": "仙途", "op": "set", "value": "2" },
            { "ref": "修为", "op": "add", "value": "20" },
            { "ref": "道心", "op": "add", "value": "5" }
          ],
          "text": "长老抚须大笑，当日便带你上山。"
        },
        {
          "id": "散修逍遥",
          "label": "婉拒仙门，做个逍遥散修",
          "effects": [
            { "ref": "仙途", "op": "set", "value": "1" },
            { "ref": "道心", "op": "add", "value": "10" },
            { "ref": "悟性", "op": "add", "value": "1" }
          ],
          "text": "你朝长老一拜：「大道三千，我自己走。」"
        }
      ]
    },
    {
      "id": "测灵根中品",
      "title": "主线：八岁测灵根（中品）",
      "priority": 80,
      "once": true,
      "condition": "time == 8 && 灵根 >= 4 && 灵根 < 7",
      "text": "八岁这年测灵根，灵石泛起微光。长老点点头：「可入外门。」",
      "choices": [
        {
          "id": "入外门",
          "label": "入外门，扫地挑水也是修行",
          "effects": [
            { "ref": "仙途", "op": "set", "value": "2" },
            { "ref": "修为", "op": "add", "value": "10" }
          ],
          "text": "你背起包袱上了山，从此晨钟暮鼓。"
        },
        {
          "id": "留在家中",
          "label": "留在家中，侍奉父母",
          "effects": [
            { "ref": "家境", "op": "add", "value": "2" },
            { "ref": "道心", "op": "add", "value": "5" }
          ],
          "text": "仙路虽好，不及灶上一碗热粥。"
        }
      ]
    },
    {
      "id": "测灵根无缘",
      "title": "主线：八岁测灵根（无缘）",
      "priority": 80,
      "once": true,
      "condition": "time == 8 && 灵根 < 4",
      "text": "八岁这年测灵根，灵石纹丝不动。长老叹了口气：「回去吧，好好过日子。」这一世，你与仙途无缘。",
      "effects": [{ "ref": "道心", "op": "add", "value": "-5" }]
    },
    {
      "id": "筑基",
      "title": "主线：筑基之关",
      "priority": 70,
      "once": true,
      "condition": "仙途 >= 1 && 修为 >= 150",
      "text": "灵力在经脉里奔涌如潮——筑基之机到了。",
      "choices": [
        {
          "id": "稳妥突破",
          "label": "稳扎稳打，循序渐进",
          "effects": [
            { "ref": "修为", "op": "add", "value": "45" },
            { "ref": "体魄", "op": "add", "value": "-5" },
            { "ref": "道心", "op": "add", "value": "5" }
          ],
          "text": "水到渠成，筑基功成。"
        },
        {
          "id": "强行冲关",
          "label": "逆势冲关，赌一把大的",
          "effects": [
            { "ref": "修为", "op": "add", "value": "chance(0.6) ? 130 : -30" },
            { "ref": "体魄", "op": "add", "value": "-randint(5, 20)" },
            { "ref": "道心", "op": "add", "value": "-5" }
          ],
          "text": "一声闷响自丹田传来——是福是祸，唯有天知。"
        }
      ]
    },
    {
      "id": "心魔劫",
      "title": "主线：心魔大劫",
      "priority": 60,
      "once": true,
      "condition": "仙途 >= 1 && 修为 >= 450",
      "text": "夜半打坐，心魔如约而至。它长着你的脸，说着你不敢说的话。",
      "choices": [
        {
          "id": "直面心魔",
