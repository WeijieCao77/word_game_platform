    {
      "id": "洽谈赞助",
      "name": "商务·拉赞助",
      "description": "花 2 万递交赞助提案（成功率吃声望与冠军履历），签约后每周固定进账，最高 3 级",
      "condition": "赞助等级 < 3 && 资金 >= 2",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-2"
        },
        {
          "ref": "运势",
          "op": "set",
          "value": "chance(clamp(0.2 + 声望 / 120 + 冠军数 * 0.15, 0.15, 0.9)) ? 1 : 0"
        },
        {
          "ref": "赞助等级",
          "op": "add",
          "value": "运势 == 1 ? 1 : 0"
        }
      ],
      "text": "{运势 == 1 ? \"市场部当场拍板，新赞助合同签字盖章！\" : \"对方笑得客气：「等你们下个阶段的成绩出来再聊。」\"}（赞助等级 {赞助等级}）"
