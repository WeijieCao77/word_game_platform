      "weight": 4,
      "condition": "time >= 60 && 仙途 == 0",
      "text": "镜子里的白发又多了几根。凡人的身子，终究是拗不过岁月。",
      "effects": [{ "ref": "体魄", "op": "add", "value": "-randint(3, 7)" }]
    },
