# ---- 数据 ----
# SQLite 数据目录（Railway 上挂 Volume 后指到挂载点，如 /data）
DATA_DIR=./data

# ---- AI 驻场策划（不配置也能用平台，AI 面板会提示未配置）----
# 推荐：多供应商共存，各家 key 各自存放，切换只改 AI_PROVIDER 一个变量
#   AI_PROVIDER=openai | deepseek | anthropic | qwen | kimi
#   AI_MODEL 可选，不填用该供应商默认模型（gpt-5-mini / deepseek-chat / claude-haiku-4-5 / qwen-plus / moonshot-v1-8k）
AI_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
AI_MODEL=

# 旧用法（不设 AI_PROVIDER 时生效）：AI_BASE_URL + AI_API_KEY + AI_MODEL 三件套
AI_BASE_URL=
AI_API_KEY=

# gpt-5 系推理深度（minimal/low/medium/high），交互式工作台建议 low
AI_REASONING_EFFORT=low

# 每把编辑钥匙的每日 AI 配额（防薅）
AI_DAILY_REQUESTS=40
AI_DAILY_TOKENS=400000

# 首页「旗舰作品」外链位（不设则不显示），如 val manager 的公网地址
FLAGSHIP_URL=

