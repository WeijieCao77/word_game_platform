        {
          "id": "体能",
          "name": "体能",
          "min": 0,
          "max": 100
        },
        {
          "id": "年龄",
          "name": "年龄",
          "min": 15,
          "max": 40
        },
        {
          "id": "潜力",
          "name": "潜力",
          "min": 40,
          "max": 99,
          "visible": false
        }
      ]
    }
  ],
