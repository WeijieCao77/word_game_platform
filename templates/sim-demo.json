  "actions": [
    {
      "id": "特训枪法",
      "name": "特训·枪法",
      "description": "花 3 万给单人加练枪法（受潜力上限约束，消耗体能）",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\") && !tag(\"伤病\")"
      },
      "condition": "资金 >= 3",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-3"
        },
        {
          "ref": "target.枪法",
          "op": "add",
          "value": "target.枪法 < target.潜力 ? randint(1, 3) : (chance(0.3) ? 1 : 0)"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "-randint(2, 5)"
        }
      ],
      "text": "加练枪法：{target.name} 枪法 → {target.枪法}"
    },
    {
      "id": "特训意识",
      "name": "特训·意识",
      "description": "花 3 万给单人复盘录像磨意识（受潜力上限约束）",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\") && !tag(\"伤病\")"
      },
      "condition": "资金 >= 3",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-3"
        },
        {
          "ref": "target.意识",
          "op": "add",
          "value": "target.意识 < target.潜力 ? randint(1, 3) : (chance(0.3) ? 1 : 0)"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "-randint(1, 4)"
        }
      ],
      "text": "复盘特训：{target.name} 意识 → {target.意识}"
    },
    {
      "id": "战术合练",
      "name": "特训·战术合练",
      "description": "花 2 万全队合练版本战术，提升版本理解（计入战力；版本随赛季更迭，跨季清零）",
      "condition": "资金 >= 2 && 版本理解 < 12",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-2"
        },
        {
          "ref": "版本理解",
          "op": "add",
          "value": "randint(2, 4)"
        }
      ],
      "text": "全队围着战术板抠了一整天新套路，版本理解 → {版本理解}"
    },
    {
      "id": "体能调理",
      "name": "体能调理",
      "description": "花 2 万请理疗师，恢复体能",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\")"
      },
      "condition": "资金 >= 2",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-2"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "randint(6, 12)"
        }
      ],
      "text": "理疗调理：{target.name} 体能 → {target.体能}"
    },
    {
      "id": "签下新援",
      "name": "转会·签人",
      "description": "按身价从转会市场签人（名字旁不显示身价？看日志报价）",
      "target": {
        "entityType": "选手",
        "condition": "tag(\"市场\") && self.身价 <= 资金"
      },
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-target.身价"
        },
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "市场"
        },
        {
          "ref": "target",
          "op": "add_tag",
          "tag": "主力"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "3"
        }
      ],
      "text": "重磅官宣：{target.name} 加盟！转会费 {target.身价} 万"
    },
    {
      "id": "挂牌卖出",
      "name": "转会·挂牌",
      "description": "转会窗（每季前 4 周）内出售队员，回收 8 成身价；阵容不足 6 人时禁止出售，卖走主力会明显伤战力",
      "target": {
        "entityType": "选手",
        "condition": "(tag(\"主力\") || tag(\"替补\")) && !tag(\"市场\")"
      },
      "condition": "turn <= 4 && count(\"选手\", \"主力\") + count(\"选手\", \"替补\") + count(\"选手\", \"伤病\") >= 6",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "round(target.身价 * 0.8)"
        },
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "主力"
        },
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "替补"
        },
        {
          "ref": "target",
          "op": "add_tag",
          "tag": "市场"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "-4"
        }
      ],
      "text": "官宣：{target.name} 挂牌离队，转会费回收 {round(target.身价 * 0.8)} 万。训练房安静了一下午。"
    },
    {
