          "text": "你带着一身伤和满袖灵物走出秘境。"
        },
        {
          "id": "止步观望",
          "label": "在外围转转就好",
          "effects": [{ "ref": "道心", "op": "add", "value": "3" }],
          "text": "不贪，是长生路上最难得的天赋。"
        }
      ]
    },
