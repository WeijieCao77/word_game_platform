{
  "schemaVersion": 1,
  "meta": {
    "title": "修仙人生重开",
    "description": "投个好胎不如生个好灵根。一次随机的修仙人生：测灵根、入仙门、渡心魔，或者做个富家翁也不错。",
    "author": "官方示例",
    "intro": "混沌初分，一点灵光落入凡尘——是你。\n每一世的天赋皆是随机，每一年的际遇皆是未知。\n点击「过一年」，看看这一世能走多远。"
  },
  "theme": { "preset": "paper", "accent": "#8a6d3b" },
  "driver": {
    "kind": "life",
    "time": { "label": "岁", "start": 0, "step": 1, "max": 100 }
  },
  "vars": [
    { "id": "灵根", "name": "灵根", "initial": 1, "min": 1, "max": 12 },
    { "id": "悟性", "name": "悟性", "initial": 1, "min": 1, "max": 12 },
    { "id": "体魄", "name": "体魄", "initial": 50, "min": 0, "max": 100 },
    { "id": "家境", "name": "家境", "initial": 5, "min": 0, "max": 99 },
    { "id": "道心", "name": "道心", "initial": 50, "min": 0, "max": 100 },
    { "id": "修为", "name": "修为", "initial": 0, "min": 0, "max": 9999 },
    { "id": "仙途", "name": "仙途", "initial": 0, "min": 0, "max": 2, "visible": false },
    { "id": "运势", "name": "运势", "initial": 0, "min": 0, "max": 1, "visible": false }
  ],
  "cards": [
    {
      "id": "出生",
      "title": "主线：出生掷点",
      "priority": 100,
      "once": true,
      "condition": "time == 1",
      "text": "你呱呱坠地。上天掷下这一世的骰子——灵根 {灵根}，悟性 {悟性}，体魄 {体魄}，家境 {家境}。",
      "effects": [
        { "ref": "灵根", "op": "set", "value": "randint(1, 10)" },
        { "ref": "悟性", "op": "set", "value": "randint(1, 10)" },
        { "ref": "体魄", "op": "set", "value": "randint(40, 70)" },
        { "ref": "家境", "op": "set", "value": "randint(1, 10)" }
      ]
    },
    {
      "id": "开蒙",
      "title": "主线：六岁开蒙",
      "priority": 90,
      "once": true,
      "condition": "time == 6",
      "text": "六岁开蒙。先生摸着你的头说：「此子{悟性 >= 6 ? \"目有精光，非池中之物\" : \"资质平平，贵在踏实\"}。」",
      "effects": [{ "ref": "悟性", "op": "add", "value": "1" }]
    },
    {
      "id": "测灵根上品",
      "title": "主线：八岁测灵根（上品）",
      "priority": 80,
      "once": true,
      "condition": "time == 8 && 灵根 >= 7",
      "text": "八岁这年，云游的仙门长老路过村口，灵石在你掌心亮得像一轮小太阳——上品灵根！",
      "choices": [
        {
          "id": "拜入仙门",
          "label": "拜入仙门，从此长生路上争渡",
          "effects": [
            { "ref": "仙途", "op": "set", "value": "2" },
            { "ref": "修为", "op": "add", "value": "20" },
            { "ref": "道心", "op": "add", "value": "5" }
          ],
          "text": "长老抚须大笑，当日便带你上山。"
        },
        {
          "id": "散修逍遥",
          "label": "婉拒仙门，做个逍遥散修",
          "effects": [
            { "ref": "仙途", "op": "set", "value": "1" },
            { "ref": "道心", "op": "add", "value": "10" },
            { "ref": "悟性", "op": "add", "value": "1" }
          ],
          "text": "你朝长老一拜：「大道三千，我自己走。」"
        }
      ]
    },
    {
      "id": "测灵根中品",
      "title": "主线：八岁测灵根（中品）",
      "priority": 80,
      "once": true,
      "condition": "time == 8 && 灵根 >= 4 && 灵根 < 7",
      "text": "八岁这年测灵根，灵石泛起微光。长老点点头：「可入外门。」",
      "choices": [
        {
          "id": "入外门",
          "label": "入外门，扫地挑水也是修行",
          "effects": [
            { "ref": "仙途", "op": "set", "value": "2" },
            { "ref": "修为", "op": "add", "value": "10" }
          ],
          "text": "你背起包袱上了山，从此晨钟暮鼓。"
        },
        {
          "id": "留在家中",
          "label": "留在家中，侍奉父母",
          "effects": [
            { "ref": "家境", "op": "add", "value": "2" },
            { "ref": "道心", "op": "add", "value": "5" }
          ],
          "text": "仙路虽好，不及灶上一碗热粥。"
        }
      ]
    },
    {
      "id": "测灵根无缘",
      "title": "主线：八岁测灵根（无缘）",
      "priority": 80,
      "once": true,
      "condition": "time == 8 && 灵根 < 4",
      "text": "八岁这年测灵根，灵石纹丝不动。长老叹了口气：「回去吧，好好过日子。」这一世，你与仙途无缘。",
      "effects": [{ "ref": "道心", "op": "add", "value": "-5" }]
    },
    {
      "id": "筑基",
      "title": "主线：筑基之关",
      "priority": 70,
      "once": true,
      "condition": "仙途 >= 1 && 修为 >= 150",
      "text": "灵力在经脉里奔涌如潮——筑基之机到了。",
      "choices": [
        {
          "id": "稳妥突破",
          "label": "稳扎稳打，循序渐进",
          "effects": [
            { "ref": "修为", "op": "add", "value": "45" },
            { "ref": "体魄", "op": "add", "value": "-5" },
            { "ref": "道心", "op": "add", "value": "5" }
          ],
          "text": "水到渠成，筑基功成。"
        },
        {
          "id": "强行冲关",
          "label": "逆势冲关，赌一把大的",
          "effects": [
            { "ref": "修为", "op": "add", "value": "chance(0.6) ? 130 : -30" },
            { "ref": "体魄", "op": "add", "value": "-randint(5, 20)" },
            { "ref": "道心", "op": "add", "value": "-5" }
          ],
          "text": "一声闷响自丹田传来——是福是祸，唯有天知。"
        }
      ]
    },
    {
      "id": "心魔劫",
      "title": "主线：心魔大劫",
      "priority": 60,
      "once": true,
      "condition": "仙途 >= 1 && 修为 >= 450",
      "text": "夜半打坐，心魔如约而至。它长着你的脸，说着你不敢说的话。",
      "choices": [
        {
          "id": "直面心魔",
          "label": "拔剑，与自己对视",
          "effects": [{ "ref": "道心", "op": "add", "value": "chance(0.55) ? 20 : -35" }],
          "text": "一剑落下，不知斩碎的是心魔，还是心防。"
        },
        {
          "id": "借助外物",
          "label": "散尽家财，购静心丹护道",
          "effects": [
            { "ref": "家境", "op": "add", "value": "-4" },
            { "ref": "道心", "op": "add", "value": "8" }
          ],
          "text": "丹香袅袅，心湖重归平静。钱财乃身外之物——你如此安慰自己。"
        }
      ]
    },
    {
      "id": "河边摸鱼",
      "title": "童年：河边摸鱼",
      "weight": 3,
      "condition": "time < 8",
      "text": "夏天的河水很凉，你摸上来三条鱼，晒得黑了一圈。",
      "effects": [{ "ref": "体魄", "op": "add", "value": "2" }]
    },
    {
      "id": "私塾识字",
      "title": "童年：私塾识字",
      "weight": 2,
      "condition": "time < 8",
      "text": "你趴在私塾窗外偷听，先生索性招手让你进来坐。",
      "effects": [{ "ref": "悟性", "op": "add", "value": "1" }]
    },
    {
      "id": "染病",
      "title": "童年：一场大病",
      "weight": 1,
      "condition": "time < 8",
      "text": "一场风寒来势汹汹，你在床上躺了半个月。",
      "effects": [{ "ref": "体魄", "op": "add", "value": "-5" }]
    },
    {
      "id": "打坐修炼",
      "title": "修仙：打坐修炼",
      "weight": 8,
      "condition": "仙途 >= 1",
      "text": "晨露未晞，你已在崖边打坐。灵气如丝，缓缓入体。（修为 {修为}）",
      "effects": [
        { "ref": "修为", "op": "add", "value": "灵根 * 2 + 悟性 + randint(0, 8)" },
        { "ref": "道心", "op": "add", "value": "1" }
      ]
    },
    {
      "id": "论道",
      "title": "修仙：与人论道",
      "weight": 2,
      "condition": "仙途 >= 1",
      "text": "山中来了位辩才无碍的道友，你与他论了三天三夜。",
      "effects": [
        { "ref": "悟性", "op": "add", "value": "chance(0.4) ? 1 : 0" },
        { "ref": "修为", "op": "add", "value": "8" }
      ]
    },
    {
      "id": "心魔滋生",
      "title": "修仙：心魔滋生",
      "weight": 2,
      "condition": "仙途 >= 1 && 道心 < 85",
      "text": "境界停滞的焦躁像藤蔓一样缠上心头。",
      "effects": [{ "ref": "道心", "op": "add", "value": "-randint(3, 8)" }]
    },
    {
      "id": "秘境探险",
      "title": "修仙：秘境现世",
      "weight": 2,
      "condition": "仙途 >= 1 && 修为 >= 100",
      "text": "附近山中惊现上古秘境，机缘与凶险同在。",
      "choices": [
        {
          "id": "深入秘境",
          "label": "深入秘境，富贵险中求",
