  "derived": [
    {
      "id": "战力",
      "name": "战力",
      "expr": "avg(\"选手\", \"枪法\", \"主力\") * 0.45 + avg(\"选手\", \"意识\", \"主力\") * 0.35 + avg(\"选手\", \"体能\", \"主力\") * 0.1 + 士气 * 0.1"
    }
  ],
  "actions": [
    {
      "id": "特训枪法",
      "name": "特训·枪法",
      "description": "花 3 万加练枪法（受潜力上限约束，消耗体能）",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\")"
      },
      "condition": "资金 >= 3",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-3"
        },
        {
          "ref": "target.枪法",
          "op": "add",
          "value": "target.枪法 < target.潜力 ? randint(1, 3) : (chance(0.3) ? 1 : 0)"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "-randint(2, 5)"
        }
      ],
      "text": "加练枪法：{target.name} 枪法 → {target.枪法}"
    },
    {
      "id": "特训意识",
      "name": "特训·意识",
      "description": "花 3 万复盘录像磨意识（受潜力上限约束）",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\")"
      },
      "condition": "资金 >= 3",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-3"
        },
        {
          "ref": "target.意识",
          "op": "add",
          "value": "target.意识 < target.潜力 ? randint(1, 3) : (chance(0.3) ? 1 : 0)"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "-randint(1, 4)"
        }
      ],
      "text": "复盘特训：{target.name} 意识 → {target.意识}"
    },
    {
      "id": "体能调理",
      "name": "体能调理",
      "description": "花 2 万请理疗师，恢复体能",
      "target": {
        "entityType": "选手",
        "condition": "!tag(\"市场\")"
      },
      "condition": "资金 >= 2",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-2"
        },
        {
          "ref": "target.体能",
          "op": "add",
          "value": "randint(6, 12)"
        }
      ],
      "text": "理疗调理：{target.name} 体能 → {target.体能}"
    },
    {
      "id": "签下新援",
      "name": "转会·签人",
      "description": "花 25 万从转会市场签下选手",
      "target": {
        "entityType": "选手",
        "condition": "tag(\"市场\")"
      },
      "condition": "资金 >= 25",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-25"
        },
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "市场"
        },
        {
          "ref": "target",
          "op": "add_tag",
          "tag": "主力"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "3"
        }
      ],
      "text": "重磅官宣：{target.name} 加盟北辰！转会费 25 万"
    },
    {
      "id": "轮换休整",
      "name": "轮换·下放",
      "description": "把主力转入替补席休整（不再计入战力，不再消耗体能）",
      "target": {
        "entityType": "选手",
        "condition": "tag(\"主力\")"
      },
      "usesPerTurn": 2,
      "effects": [
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "主力"
        },
        {
          "ref": "target",
          "op": "add_tag",
          "tag": "替补"
        }
      ],
      "text": "{target.name} 转入替补席休整"
    },
    {
      "id": "提拔首发",
      "name": "轮换·提拔",
      "description": "把替补提上首发（计入战力）",
      "target": {
        "entityType": "选手",
        "condition": "tag(\"替补\")"
      },
      "usesPerTurn": 2,
      "effects": [
        {
          "ref": "target",
          "op": "remove_tag",
          "tag": "替补"
        },
        {
          "ref": "target",
          "op": "add_tag",
          "tag": "主力"
        }
      ],
      "text": "{target.name} 进入首发名单"
    },
    {
      "id": "商业活动",
      "name": "商务·接活动",
      "description": "接商务活动赚钱，队员会有点怨言",
      "condition": "声望 >= 25",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "randint(6, 12)"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "-3"
        }
      ],
      "text": "接了场商务活动，进账不少，训练时间少了半天"
    },
    {
      "id": "团建",
      "name": "后勤·团建",
      "description": "花 5 万全队团建，回复士气",
      "condition": "资金 >= 5",
      "effects": [
        {
          "ref": "资金",
          "op": "add",
          "value": "-5"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "randint(6, 12)"
        }
      ],
      "text": "全队火锅局，笑声不断，士气回升"
    }
  ],
  "settlements": [
    {
      "id": "联赛周赛",
      "name": "联赛",
      "every": 1,
      "data": [
        {
          "名称": "雷霆",
          "强度": 66
        },
        {
          "名称": "星河",
          "强度": 70
        },
        {
          "名称": "暗涌",
          "强度": 63
        },
        {
          "名称": "烈阳",
          "强度": 74
        },
        {
          "名称": "孤舟",
          "强度": 60
        },
        {
          "名称": "玄武",
          "强度": 72
        },
        {
          "名称": "赤霄",
          "强度": 78
        },
        {
          "名称": "风行",
          "强度": 68
        },
        {
          "名称": "寒鸦",
          "强度": 64
        },
        {
          "名称": "王庭",
          "强度": 82
        }
      ],
      "compute": [
        {
          "id": "我方",
          "expr": "战力 + randint(-8, 8)"
        },
        {
          "id": "敌方",
          "expr": "row.强度 + randint(-8, 8)"
        },
        {
          "id": "净胜",
          "expr": "round(我方 - 敌方)"
        }
      ],
      "outcomes": [
        {
          "id": "横扫",
          "condition": "净胜 >= 8",
          "effects": [
            {
              "ref": "积分",
              "op": "add",
              "value": "3"
            },
            {
              "ref": "资金",
              "op": "add",
              "value": "8"
            },
            {
              "ref": "声望",
              "op": "add",
              "value": "3"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "5"
            }
          ],
          "text": "vs {row.名称}：2:0 横扫！解说都看嗨了（战力 {round(战力)}）"
        },
        {
          "id": "险胜",
          "condition": "净胜 > 0",
          "effects": [
            {
              "ref": "积分",
              "op": "add",
              "value": "3"
            },
            {
              "ref": "资金",
              "op": "add",
              "value": "6"
            },
            {
              "ref": "声望",
              "op": "add",
              "value": "1"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "2"
            }
          ],
          "text": "vs {row.名称}：2:1 拿下，决胜局惊出一身冷汗"
        },
        {
          "id": "惜败",
          "condition": "净胜 > -8",
          "effects": [
            {
              "ref": "资金",
              "op": "add",
              "value": "2"
            },
            {
              "ref": "声望",
              "op": "add",
              "value": "-2"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "-4"
            }
          ],
          "text": "vs {row.名称}：1:2 惜败，赛后复盘室的灯亮到半夜"
        },
        {
          "id": "溃败",
          "condition": "1",
          "effects": [
            {
              "ref": "资金",
              "op": "add",
              "value": "1"
            },
            {
              "ref": "声望",
              "op": "add",
              "value": "-4"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "-8"
            }
          ],
          "text": "vs {row.名称}：0:2 溃败，弹幕已经开始刷「下课」"
        }
      ]
    },
    {
      "id": "赛季总结",
      "name": "赛季总结",
      "every": 1,
      "condition": "turn == 10",
      "outcomes": [
        {
          "id": "夺冠",
          "condition": "积分 >= 24",
          "effects": [
            {
              "ref": "冠军数",
              "op": "add",
              "value": "1"
            },
            {
              "ref": "声望",
              "op": "add",
              "value": "15"
            },
            {
              "ref": "资金",
              "op": "add",
              "value": "30"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "10"
            }
          ],
          "text": "🏆 以 {积分} 分登顶！北辰捧起赛季冠军奖杯，全场高呼你的名字！"
        },
        {
          "id": "季后赛",
          "condition": "积分 >= 15",
          "effects": [
            {
              "ref": "声望",
              "op": "add",
              "value": "5"
            },
            {
              "ref": "资金",
              "op": "add",
              "value": "12"
            }
          ],
          "text": "以 {积分} 分闯进季后赛。没摸到奖杯，但赞助商的电话多起来了"
        },
        {
          "id": "垫底",
          "condition": "1",
          "effects": [
            {
              "ref": "声望",
              "op": "add",
              "value": "-10"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "-6"
            }
          ],
          "text": "以 {积分} 分结束赛季。管理层的脸色和更衣室的空气一样冷"
        }
      ]
    }
  ],
  "curves": [
    {
      "id": "每周消耗",
      "name": "主力消耗",
      "entityType": "选手",
      "phase": "turn",
      "condition": "tag(\"主力\")",
      "effects": [
        {
          "ref": "self.体能",
          "op": "add",
          "value": "-randint(1, 3)"
        }
      ]
    },
    {
      "id": "赛季年龄",
      "name": "年龄增长",
      "entityType": "选手",
      "phase": "cycle",
      "effects": [
        {
          "ref": "self.年龄",
          "op": "add",
          "value": "1"
        }
      ]
    },
    {
      "id": "老将衰退",
      "name": "老将衰退",
      "entityType": "选手",
      "phase": "cycle",
      "condition": "self.年龄 >= 27",
      "effects": [
        {
          "ref": "self.枪法",
          "op": "add",
          "value": "-randint(1, 3)"
        },
        {
          "ref": "self.体能",
          "op": "add",
          "value": "-randint(2, 5)"
        }
      ],
      "text": "岁月不饶人：{self.name} 的反应慢了半拍"
    },
    {
      "id": "新星成长",
      "name": "新星成长",
      "entityType": "选手",
      "phase": "cycle",
      "condition": "self.年龄 <= 21 && self.枪法 < self.潜力",
      "effects": [
        {
          "ref": "self.枪法",
          "op": "add",
          "value": "randint(1, 3)"
        },
        {
          "ref": "self.意识",
          "op": "add",
          "value": "randint(1, 2)"
        }
      ],
      "text": "休赛期训练营：{self.name} 肉眼可见地变强了"
    }
  ],
  "cards": [
    {
      "id": "状态火热",
      "weight": 3,
      "scope": {
        "entityType": "选手",
        "condition": "tag(\"主力\")"
      },
      "text": "{self.name} 最近手感火热，训练赛大杀四方，全队都被带动了。",
      "effects": [
        {
          "ref": "士气",
          "op": "add",
          "value": "4"
        }
      ]
    },
    {
      "id": "伤病警报",
      "weight": 4,
      "scope": {
        "entityType": "选手",
        "condition": "tag(\"主力\") && self.体能 < 45"
      },
      "text": "队医报告：{self.name} 的手腕出现劳损征兆（体能 {self.体能}），再硬撑要出大问题。",
      "effects": [
        {
          "ref": "self.体能",
          "op": "add",
          "value": "-8"
        },
        {
          "ref": "士气",
          "op": "add",
          "value": "-5"
        }
      ]
    },
    {
      "id": "赞助试探",
      "weight": 2,
      "condition": "声望 >= 50",
      "text": "一家外设品牌递来短约，报价不错，但要占用队员两天拍摄时间。",
      "choices": [
        {
          "id": "签约",
          "label": "签！钱不嫌多",
          "effects": [
            {
              "ref": "资金",
              "op": "add",
              "value": "15"
            },
            {
              "ref": "士气",
              "op": "add",
              "value": "-2"
            }
          ],
          "text": "广告拍得很顺利，就是队员的表演有点僵硬。"
        },
        {
          "id": "婉拒",
          "label": "赛程太紧，婉拒",
          "effects": [
            {
              "ref": "声望",
              "op": "add",
              "value": "3"
            }
          ],
          "text": "「以竞技为先」——你的回应被粉丝截图转发，风评上涨。"
        }
      ]
    },
    {
      "id": "版本更新",
      "weight": 2,
      "text": "游戏大版本更新，地图与武器数值大改，各队都在抢时间适应。",
      "choices": [
        {
          "id": "连夜研究",
          "label": "教练组连夜拆解新版本",
          "effects": [
            {
              "ref": "士气",
              "op": "add",
              "value": "-3"
            },
            {
              "ref": "声望",
              "op": "add",
              "value": "2"
            }
          ],
          "text": "队员顶着黑眼圈上场，但战术库已经翻新了一遍。"
        },
        {
          "id": "顺其自然",
          "label": "按原节奏训练，慢慢适应",
          "effects": [
            {
